# kipp as a systemd service, run by a user of its own.
#
#   useradd --system --home-dir /var/lib/kipp --create-home --shell /usr/sbin/nologin kipp
#   install -m 755 kipp /usr/local/bin/kipp
#   install -d -m 755 /etc/kipp/jobs        # the job files, written by root or a deploy
#   cp kipp.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now kipp
#   sudo -u kipp kipp user add admin --admin --data /var/lib/kipp/data
#
# `systemctl reload kipp` re-reads the job files, as `kipp reload` does.
#
# A stage runs as the user kipp, with what this unit allows it. The
# filesystem is read-only to it but for /var/lib/kipp (its home, the data
# directory and the build workspaces in it) and a private /tmp: a job whose
# workdir is elsewhere, or that writes elsewhere, needs that path in
# ReadWritePaths too. ProtectHome hides /home, /root and /run/user, which
# kipp's own home is not under, so a stage still finds ~/.ssh, ~/.gitconfig
# and its caches in /var/lib/kipp.

[Unit]
Description=kipp, a job-first CI and scheduler
Documentation=https://github.com/ndthuan/kipp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kipp
Group=kipp
ExecStart=/usr/local/bin/kipp serve --data /var/lib/kipp/data --jobs /etc/kipp/jobs --listen 127.0.0.1:8085 --base-url https://ci.example.com
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# kipp ends its running builds as lost and kills their stages when told
# to stop; this is how long it is given before systemd kills what is left.
# What a stage left running in the background, even detached with setsid,
# is in this unit's cgroup and stops with it: a daemon a job starts that
# must outlive kipp belongs in a unit of its own.
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kipp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
