# A standing kipp runner as a systemd service, run by a user of its own, on
# a machine other than the server's: it dials the server and runs the
# stages placed on it.
#
# On the server's machine, once:
#   sudo -u kipp kipp runner add build-1 --labels linux,amd64 --executors 2 --data /var/lib/kipp/data
#   (it prints the runner's token once) and reload the server.
#
# On the runner's machine:
#   useradd --system --home-dir /var/lib/kipp-runner --create-home --shell /usr/sbin/nologin kipp-runner
#   install -m 755 kipp /usr/local/bin/kipp     # the server's own version
#   install -d -m 700 /etc/kipp-runner
#   printf 'KIPP_RUNNER_TOKEN=%s\n' '<the token>' > /etc/kipp-runner/env && chmod 600 /etc/kipp-runner/env
#   cp kipp-runner.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now kipp-runner
#
# A stage runs as the user kipp-runner, in /var/lib/kipp-runner/work/<job>/<n>,
# with this unit's environment and what the server's --runner-env names:
# the server's own PATH and HOME are not given to it. To upgrade, drain
# the runner (kipp runner set build-1 --disable on the server), upgrade the
# server, then this kipp, restart this unit and enable the runner again.

[Unit]
Description=kipp runner
Documentation=https://github.com/ndthuan/kipp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kipp-runner
Group=kipp-runner
EnvironmentFile=/etc/kipp-runner/env
ExecStart=/usr/local/bin/kipp runner --url https://ci.example.com --workdir /var/lib/kipp-runner/work
Restart=on-failure
RestartSec=5
# Stopped, the runner kills the stages it runs; the server fails them as
# the runner went offline.
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kipp-runner
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
