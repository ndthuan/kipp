# A standing kipp agent as a systemd service, run by a user of its own, on
# a machine other than the server's: it dials the server and runs the
# stages placed on it.
#
# On the server's machine, once:
#   sudo -u kipp kipp agent add build-1 --labels linux,amd64 --executors 2 --data /var/lib/kipp/data
#   (it prints the agent's token once) and reload the server.
#
# On the agent's machine:
#   useradd --system --home-dir /var/lib/kipp-agent --create-home --shell /usr/sbin/nologin kipp-agent
#   install -m 755 kipp /usr/local/bin/kipp     # the server's own version
#   install -d -m 700 /etc/kipp-agent
#   printf 'KIPP_AGENT_TOKEN=%s\n' '<the token>' > /etc/kipp-agent/env && chmod 600 /etc/kipp-agent/env
#   cp kipp-agent.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now kipp-agent
#
# A stage runs as the user kipp-agent, in /var/lib/kipp-agent/work/<job>/<n>,
# with this unit's environment and what the server's --agent-env names:
# the server's own PATH and HOME are not given to it. To upgrade, drain
# the agent (kipp agent set build-1 --disable on the server), upgrade the
# server, then this kipp, restart this unit and enable the agent again.

[Unit]
Description=kipp agent
Documentation=https://github.com/ndthuan/kipp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kipp-agent
Group=kipp-agent
EnvironmentFile=/etc/kipp-agent/env
ExecStart=/usr/local/bin/kipp agent --url https://ci.example.com --workdir /var/lib/kipp-agent/work
Restart=on-failure
RestartSec=5
# Stopped, the agent kills the stages it runs; the server fails them as
# the agent went offline.
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kipp-agent
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
